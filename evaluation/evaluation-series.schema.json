{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bmo.local/schemas/evaluation-series.schema.json",
  "title": "BMO Evaluation Series v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runs"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "metadata", "results"],
        "properties": {
          "schemaVersion": { "const": "2.0" },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": ["runId", "createdAt", "mode", "runtime", "model", "reasoningEffort", "codeRevision", "configurationFingerprint", "evaluationFingerprint", "modelMeasuredCaseIds", "repetition", "canarySet"],
            "properties": {
              "runId": { "type": "string", "minLength": 1 },
              "createdAt": { "type": "string", "format": "date-time" },
              "mode": { "enum": ["deterministic-fixture", "live-runtime"] },
              "runtime": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "reasoningEffort": { "type": "string", "minLength": 1 },
              "codeRevision": { "type": "string", "minLength": 1 },
              "configurationFingerprint": { "type": "string", "minLength": 1 },
              "evaluationFingerprint": { "type": "string", "minLength": 1 },
              "modelMeasuredCaseIds": { "$ref": "#/$defs/strings" },
              "repetition": { "type": "integer", "minimum": 1 },
              "canarySet": { "$ref": "#/$defs/strings" }
            }
          },
          "results": { "type": "array", "minItems": 1, "items": { "$ref": "evaluation-result.schema.json" } }
        }
      }
    }
  },
  "$defs": {
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
