{
  "name": "bmo-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm run electron:compile && concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && NODE_ENV=development electron dist-electron/main.js\"",
    "build": "vite build && npm run electron:compile",
    "electron:compile": "tsc -p electron/tsconfig.json && cp electron/preload.cjs dist-electron/preload.cjs && cp electron/laya-router.py dist-electron/laya-router.py && mkdir -p dist-electron/native && cp native/BMOAppleBridge.swift dist-electron/native/BMOAppleBridge.swift && node --check dist-electron/preload.cjs",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit && tsc -p evaluation/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:reliability": "python3 -m unittest discover -s tests_python -v",
    "eval:canaries": "tsx evaluation/cli.ts",
    "eval:tool-schemas": "tsx evaluation/tool-schema-lab.ts",
    "eval:coding-agents": "tsx evaluation/coding-agent-compare.ts",
    "eval:pi-coding-live": "tsx evaluation/pi-coding-adapter-live.ts",
    "eval:laya-routing": "tsx evaluation/laya-routing-lab.ts",
    "setup:laya": "sh scripts/setup-laya.sh",
    "eval:project-workflow-live": "tsx evaluation/project-workflow-live.ts",
    "eval:node-project-workflow-live": "tsx evaluation/node-project-workflow-live.ts"
  },
  "dependencies": {
    "electron": "^35.7.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wait-on": "^9.0.4"
  }
}
